class Solution {
    public int longestSubstr(String s, int k) {
       int n = s.length();
       int[] freq = new int[26];
       int l = 0;
       int max = 0;
       int minLen = 0;
       for(int r = 0;r<n;r++){
           freq[s.charAt(r) - 'A']++;
           minLen = Math.max(minLen,freq[s.charAt(r) - 'A']);
           if((r - l + 1) - minLen > k){
               freq[s.charAt(l) - 'A']--;
               l++;
           }
           max = Math.max(max,r-l+1);
       }
       return max;
    }
}
